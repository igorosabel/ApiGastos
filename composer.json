{
  "name": "igorosabel/apigastos",
  "description": "API para la gestión de gastos e ingresos personales y compartidos.",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Iñigo Gorosabel",
      "homepage": "https://osumi.es",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "osumionline/framework": "^9.12.1",
    "osumionline/plugin-token": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Osumi\\OsumiFramework\\App\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "osumionline/plugin-updater": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
